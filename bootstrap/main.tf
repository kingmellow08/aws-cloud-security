data "aws_partition" "current" {}

locals {
  partition = data.aws_partition.current.partition

  # One bucket per account and Region. Including the account ID means two
  # accounts can never resolve to the same state location.
  state_bucket_name = "${var.name_prefix}-tfstate-${var.account_id}-${var.aws_region}"
  state_bucket_arn  = "arn:${local.partition}:s3:::${local.state_bucket_name}"

  state_keys = { for s in var.state_scopes : s => "${var.project_name}/${s}/terraform.tfstate" }
  env_scopes = toset([for s in var.state_scopes : s if s != "account-baseline"])

  deployer_role_path  = "/${var.name_prefix}/terraform/"
  deployer_role_names = { for s in var.state_scopes : s => "${var.name_prefix}-tf-${s}" }
  deployer_role_arns  = { for s, n in local.deployer_role_names : s => "arn:${local.partition}:iam::${var.account_id}:role${local.deployer_role_path}${n}" }
}

module "state_kms" {
  source = "../modules/kms-key"

  alias                   = "${var.name_prefix}-tfstate"
  description             = "Encrypts Terraform state for ${var.project_name} in ${var.account_id}/${var.aws_region}"
  deletion_window_in_days = 30
  prevent_destroy         = true
}

data "aws_iam_policy_document" "state_bucket" {
  # Each root module can only read and write objects under its own key
  # prefix. A dev deployer cannot read or overwrite account-baseline state.
  dynamic "statement" {
    for_each = local.state_keys
    content {
      sid       = "IsolateStateScope${replace(title(replace(statement.key, "-", " ")), " ", "")}"
      effect    = "Deny"
      actions   = ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"]
      resources = ["${local.state_bucket_arn}/${var.project_name}/${statement.key}/*"]

      principals {
        type        = "AWS"
        identifiers = ["*"]
      }

      condition {
        test     = "ArnNotLike"
        variable = "aws:PrincipalArn"
        values   = concat([local.deployer_role_arns[statement.key]], var.break_glass_principal_arns)
      }
    }
  }

  # Previous state versions are the recovery path; only break-glass
  # principals may remove them.
  statement {
    sid       = "ProtectStateHistory"
    effect    = "Deny"
    actions   = ["s3:DeleteObjectVersion"]
    resources = ["${local.state_bucket_arn}/*"]

    principals {
      type        = "AWS"
      identifiers = ["*"]
    }

    dynamic "condition" {
      for_each = length(var.break_glass_principal_arns) > 0 ? [1] : []
      content {
        test     = "ArnNotLike"
        variable = "aws:PrincipalArn"
        values   = var.break_glass_principal_arns
      }
    }
  }
}

module "state_bucket" {
  source = "../modules/secure-s3-bucket"

  bucket_name                        = local.state_bucket_name
  kms_key_arn                        = module.state_kms.key_arn
  prevent_destroy                    = true
  noncurrent_version_expiration_days = var.state_noncurrent_version_retention_days
  additional_policy_json             = data.aws_iam_policy_document.state_bucket.json
}

# Partial backend configuration consumed by every remote-state root module:
#   terraform init -backend-config=../backend-config/<account>-<region>.s3.tfbackend
# It holds locations only; credentials always come from the caller's AWS
# profile or environment.
resource "local_file" "backend_config" {
  filename        = "${path.module}/../backend-config/${var.account_id}-${var.aws_region}.s3.tfbackend"
  file_permission = "0644"
  content         = <<-EOT
    # Generated by bootstrap/ for account ${var.account_id} (${var.aws_region}).
    # Do not edit by hand: re-run `terraform apply` in bootstrap/ instead.
    # Contains no credentials. The state key is set in each root's backend.tf.
    bucket              = "${module.state_bucket.bucket_id}"
    region              = "${var.aws_region}"
    kms_key_id          = "${module.state_kms.key_arn}"
    allowed_account_ids = ["${var.account_id}"]
  EOT
}
